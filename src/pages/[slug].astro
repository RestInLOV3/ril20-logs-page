---
import LogsLayout from "../layouts/LogsLayout.astro";
import CharacterPopup from "../components/CharacterPopup";
import ReviewChat from "../components/ReviewChat";
import { bindings } from "../lib/bindings";
import { r2KeyToUrl } from "../lib/r2";

const { slug } = Astro.params as { slug: string };
const { DB, R2_PUBLIC_URL } = bindings;

const scenario = await DB.prepare("SELECT * FROM scenarios WHERE slug = ?")
  .bind(slug)
  .first<Record<string, unknown>>();

if (!scenario) return Astro.redirect("/logs");

const { results: chars } = await DB.prepare(
  "SELECT * FROM characters WHERE scenario_id = ? ORDER BY sort_order",
)
  .bind(scenario.id)
  .all<Record<string, unknown>>();

const { results: quotes } = await DB.prepare(
  `SELECT * FROM character_quotes WHERE character_id IN
   (SELECT id FROM characters WHERE scenario_id = ?)`,
)
  .bind(scenario.id)
  .all<Record<string, unknown>>();

const quotesByChar = new Map<number, string[]>();
for (const q of quotes) {
  const cid = q.character_id as number;
  if (!quotesByChar.has(cid)) quotesByChar.set(cid, []);
  quotesByChar.get(cid)!.push(q.quote as string);
}

interface CharRow {
  id: number;
  name: string;
  pl_name: string;
  image_r2: string | null;
  bio: string | null;
}
interface ReviewRow {
  id: number;
  pl_name: string | null;
  content: string;
  created_at: string;
}
interface LogRow {
  id: number;
  title: string;
  order_num: number;
}

const characters = (chars as unknown as CharRow[]).map((ch) => ({
  id: ch.id,
  name: ch.name,
  pl_name: ch.pl_name,
  image_url: r2KeyToUrl(ch.image_r2, R2_PUBLIC_URL),
  bio: ch.bio,
  quotes: quotesByChar.get(ch.id) ?? [],
}));

// 모바일 줄 나눔: 4인 이상이면 두 줄 (2+2, 3+2, 3+3). 데스크톱은 한 줄로 이어 붙임
const perRow =
  characters.length >= 4 ? Math.ceil(characters.length / 2) : characters.length;
const charRows = [];
for (let i = 0; i < characters.length; i += perRow) {
  charRows.push(characters.slice(i, i + perRow));
}

const { results: logs } = await DB.prepare(
  "SELECT id, title, order_num FROM logs WHERE scenario_id = ? ORDER BY order_num",
)
  .bind(scenario.id)
  .all<LogRow>();

// 메시지 앱처럼 오래된 순 (ReviewChat이 날짜 구분·묶음 처리)
const { results: reviews } = await DB.prepare(
  `SELECT id, pl_name, content, created_at FROM reviews
   WHERE scenario_id = ? ORDER BY created_at ASC, id ASC`,
)
  .bind(scenario.id)
  .all<ReviewRow>();

// 후기 사이드탭 상태바 시계 (KST, 이후 클라이언트에서 갱신)
const kstClock = new Date(Date.now() + 9 * 60 * 60 * 1000)
  .toISOString()
  .slice(11, 16)
  .replace(/^0/, "");

const coverUrl = r2KeyToUrl(scenario.cover_r2 as string | null, R2_PUBLIC_URL);
const color = scenario.color as string;
---

<LogsLayout
  title={`${scenario.title as string} — ril20 logs`}
  description={(scenario.description as string) ?? ""}
  image={coverUrl}
  wide
>
  <div
    class={`scenario-header${coverUrl ? " has-cover" : ""}`}
    style={`--c: ${color}${coverUrl ? `; background-image: url('${coverUrl}')` : ""}`}
  >
    <div class="scenario-meta">
      <h1 class="scenario-title">{scenario.title as string}</h1>
      {
        scenario.description && (
          <p class="scenario-desc">{scenario.description as string}</p>
        )
      }
    </div>
  </div>

  <div class="scenario-body" style={`--c: ${color}`}>
    <div class="main-col">
      <section class="section">
        <div class="character-grid">
          {
            charRows.map((row, r) => (
              <ul class="char-row">
                {row.map((ch, j) => {
                  const i = r * perRow + j;
                  return (
                    <li
                      class:list={{
                        "g-down": i % 2 === 1,
                        "r-down": j % 2 === 1,
                      }}
                    >
                      <CharacterPopup
                        character={ch}
                        accentColor={color}
                        client:load
                      />
                    </li>
                  );
                })}
              </ul>
            ))
          }
        </div>
      </section>

      <section class="section">
        {logs.length === 0 && <p class="empty">아직 등록된 로그가 없습니다.</p>}
        <ol class="log-list">
          {
            logs.map((log) => (
              <li class="log-item">
                <a href={`/logs/${slug}/${log.id}`}>
                  <span class="log-num">
                    {String(log.order_num).padStart(2, "0")}
                  </span>
                  <span class="log-title">{log.title}</span>
                  <span class="log-arrow" aria-hidden="true">
                    ▸
                  </span>
                </a>
              </li>
            ))
          }
        </ol>
      </section>
    </div>

    <aside class="side-tab" aria-label="후기">
      <div class="phone-status" aria-hidden="true">
        <span class="status-time" data-kst-clock>{kstClock}</span>
        <span class="status-icons">
          <svg viewBox="0 0 18 12" width="17" height="11">
            <rect x="0" y="8" width="3" height="4" rx="0.8"></rect>
            <rect x="5" y="5.5" width="3" height="6.5" rx="0.8"></rect>
            <rect x="10" y="3" width="3" height="9" rx="0.8"></rect>
            <rect x="15" y="0" width="3" height="12" rx="0.8"></rect>
          </svg>
          <svg viewBox="0 0 16 12" width="15" height="11">
            <path
              d="M8 2.3c2.3 0 4.4.9 6 2.4l1.3-1.4A10.6 10.6 0 0 0 8 .4C5.2.4 2.6 1.5.7 3.3L2 4.7a8.7 8.7 0 0 1 6-2.4z"
            ></path>
            <path
              d="M8 6c1.3 0 2.5.5 3.4 1.3l1.3-1.4A6.8 6.8 0 0 0 8 4.1c-1.8 0-3.5.7-4.7 1.8l1.3 1.4C5.5 6.5 6.7 6 8 6z"
            ></path>
            <path d="M8 9.4c.5 0 .9.2 1.2.5L8 11.3 6.8 9.9c.3-.3.7-.5 1.2-.5z"
            ></path>
          </svg>
          <svg viewBox="0 0 27 12" width="25" height="11">
            <rect
              x="0.5"
              y="0.5"
              width="22"
              height="11"
              rx="3"
              fill="none"
              stroke="currentColor"
              opacity="0.4"></rect>
            <rect x="2" y="2" width="16" height="8" rx="1.8"></rect>
            <path d="M24 4v4c.8-.3 1.5-1.1 1.5-2S24.8 4.3 24 4z" opacity="0.4"
            ></path>
          </svg>
        </span>
      </div>

      <div class="phone-body">
        <ReviewChat
          scenarioSlug={slug}
          accentColor={color}
          initialReviews={reviews}
          client:load
        />
      </div>
    </aside>
  </div>
</LogsLayout>

<script>
  // 휴대폰 상태바 시계: 한국 시간 기준
  const clock = document.querySelector<HTMLElement>("[data-kst-clock]");
  const tick = () => {
    if (!clock) return;
    clock.textContent = new Intl.DateTimeFormat("ko-KR", {
      timeZone: "Asia/Seoul",
      hour: "numeric",
      minute: "2-digit",
      hourCycle: "h23",
    })
      .format(new Date())
      .replace(/^0/, "");
  };
  tick();
  setInterval(tick, 30_000);
</script>

<style>
  .scenario-header {
    position: relative;
    width: 100vw;
    justify-self: center;
    margin-bottom: 3rem;
    overflow: hidden;
    background: var(--surface);
    background-size: cover;
    background-position: center;
  }
  .scenario-header.has-cover {
    min-height: 280px;
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
  }
  .scenario-header.has-cover::after {
    content: "";
    position: absolute;
    inset: 0;
    background: linear-gradient(
      to bottom,
      transparent 20%,
      rgba(0, 0, 0, 0.65) 100%
    );
    pointer-events: none;
  }
  .scenario-meta {
    position: relative;
    z-index: 1;
    padding: 1.5rem clamp(1.5rem, 10vw, 15rem);
  }
  .has-cover .scenario-title,
  .has-cover .scenario-desc {
    color: #fff;
    text-shadow: 0 1px 4px rgba(0, 0, 0, 0.5);
  }
  .has-cover .scenario-desc {
    color: rgba(255, 255, 255, 0.85);
  }
  .breadcrumb {
    font-size: 0.82rem;
    color: var(--muted);
    margin-bottom: 0.75rem;
  }
  .breadcrumb a {
    color: var(--muted);
    text-decoration: none;
  }
  .scenario-title {
    font-size: 1.6rem;
    font-weight: 700;
    margin-bottom: 0.5rem;
    color: var(--text);
  }
  .scenario-desc {
    color: var(--muted);
    font-size: 0.9rem;
    line-height: 1.6;
  }

  /* 2단 레이아웃: 왼쪽 캐릭터·로그, 오른쪽 후기 사이드탭 */
  .scenario-body {
    --chamfer: 12px;
    display: grid;
    /* 후기는 부가 요소: 전체의 약 30% 폭 */
    grid-template-columns: minmax(0, 1fr) clamp(280px, 30%, 400px);
    gap: clamp(2rem, 4vw, 3.5rem);
    align-items: start;
  }
  @media (max-width: 860px) {
    .scenario-body {
      grid-template-columns: minmax(0, 1fr);
    }
  }
  .section {
    margin-bottom: 3.5rem;
  }
  .empty {
    color: var(--muted);
    font-size: 0.9rem;
    text-align: center;
    padding: 1.5rem 0;
  }

  /* 참고 이미지의 '선 + 마름모 노드' 모티프 */
  .divider {
    position: relative;
    height: 12px;
    margin: 0 0 2rem;
  }
  .divider::before {
    content: "";
    position: absolute;
    left: 0;
    right: 0;
    top: 50%;
    border-top: 1px solid color-mix(in srgb, var(--c) 45%, var(--border));
  }
  .divider span {
    position: absolute;
    left: 50%;
    top: 50%;
    width: 10px;
    height: 10px;
    background: var(--c);
    outline: 3px solid var(--bg);
    transform: translate(-50%, -50%) rotate(45deg);
  }

  /* 마름모 지그재그 배치: 이웃 마름모가 대각선 반만큼 겹치고, 짝수 번째는 아래로 내려감.
     --d(마름모 대각선)는 인원수와 무관하게 화면 폭으로만 결정.
     n개 한 줄의 폭 = d·(n+1)/2 + (n-1)·g → 데스크톱은 6개, 모바일은 3개 기준 */
  .character-grid {
    --g: 0.5rem;
    --d: min(130px, (100% - 5 * var(--g)) * 2 / 7);
    display: flex;
    justify-content: center;
    align-items: flex-start;
  }
  .char-row {
    display: contents;
    list-style: none;
    padding: 0;
  }
  .char-row > li {
    position: relative;
    flex: 0 0 auto;
    width: var(--d);
    aspect-ratio: 1;
    margin-left: calc(var(--d) / -2 + var(--g));
  }
  .char-row:first-child > li:first-child {
    margin-left: 0;
  }
  .char-row > li.g-down {
    margin-top: calc(var(--d) / 2 + var(--g));
  }
  .char-row > li:hover,
  .char-row > li:focus-within {
    z-index: 1;
  }
  @media (max-width: 600px) {
    .character-grid {
      --d: min(110px, (100% - 2 * var(--g)) / 2);
      flex-direction: column;
      align-items: stretch;
      gap: var(--g);
    }
    .char-row {
      display: flex;
      justify-content: center;
      align-items: flex-start;
      width: 100%;
    }
    .char-row > li:first-child {
      margin-left: 0;
    }
    .char-row > li.g-down {
      margin-top: 0;
    }
    .char-row > li.r-down {
      margin-top: calc(var(--d) / 2 + var(--g));
    }
  }

  /* 로그 목록: 모서리를 깎은 게임 메뉴 스타일 */
  .log-list {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    padding: 0;
  }
  .log-item a {
    position: relative;
    display: flex;
    align-items: center;
    gap: 1rem;
    padding: 0.8rem 1.1rem;
    color: var(--text);
    background: var(--surface);
    clip-path: polygon(
      var(--chamfer) 0,
      100% 0,
      100% calc(100% - var(--chamfer)),
      calc(100% - var(--chamfer)) 100%,
      0 100%,
      0 var(--chamfer)
    );
    transition:
      background 0.2s,
      color 0.2s,
      padding-left 0.25s ease;
  }
  .log-item a::before {
    content: "";
    position: absolute;
    left: 0;
    top: 0;
    bottom: 0;
    width: 3px;
    background: var(--c);
    transform: scaleY(0.35);
    transition: transform 0.25s ease;
  }
  .log-item a:hover {
    opacity: 1;
    padding-left: 1.5rem;
    background: color-mix(in srgb, var(--c) 10%, var(--surface));
  }
  .log-item a:hover::before {
    transform: scaleY(1);
  }
  .log-num {
    font-size: 0.78rem;
    font-weight: 700;
    font-variant-numeric: tabular-nums;
    color: var(--c);
    min-width: 1.5rem;
  }
  .log-title {
    flex: 1;
    font-size: 0.92rem;
  }
  .log-arrow {
    font-size: 0.8rem;
    color: var(--c);
    opacity: 0;
    transform: translateX(-6px);
    transition:
      opacity 0.2s,
      transform 0.25s ease;
  }
  .log-item a:hover .log-arrow {
    opacity: 1;
    transform: none;
  }

  /* 후기 사이드탭: 데스크톱에서는 스크롤을 따라오는 패널 */
  .side-tab {
    --panel-bg: color-mix(in srgb, var(--c) 5%, var(--surface));
    position: sticky;
    top: 1.5rem;
    display: flex;
    flex-direction: column;
    max-height: calc(100vh - 3rem);
    background: var(--panel-bg);
    clip-path: polygon(
      var(--chamfer) 0,
      calc(100% - var(--chamfer)) 0,
      100% var(--chamfer),
      100% calc(100% - var(--chamfer)),
      calc(100% - var(--chamfer)) 100%,
      var(--chamfer) 100%,
      0 calc(100% - var(--chamfer)),
      0 var(--chamfer)
    );
  }
  @media (max-width: 860px) {
    .side-tab {
      position: static;
      max-height: none;
    }
  }

  /* 상태바: 시계 · 다이내믹 아일랜드 · 신호/와이파이/배터리 */
  .phone-status {
    position: relative;
    display: flex;
    align-items: center;
    justify-content: space-between;
    height: 44px;
    padding: 0 1.4rem 0 1.8rem;
    color: #000;
    flex-shrink: 0;
  }
  .status-time {
    font-size: 0.85rem;
    font-weight: 600;
    letter-spacing: 0;
    font-variant-numeric: tabular-nums;
  }
  .status-icons {
    display: flex;
    align-items: center;
    gap: 5px;
  }
  .status-icons svg {
    display: block;
    fill: currentColor;
  }

  .phone-body {
    flex: 1;
    min-height: 0;
    display: flex;
    flex-direction: column;
    padding: 0.5rem 1rem 1.25rem;
  }
</style>
