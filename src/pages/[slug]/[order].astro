---
import LogsLayout from "../../layouts/LogsLayout.astro";
import { bindings } from "../../lib/bindings";
import { getFromR2 } from "../../lib/r2";

// URL 숫자 = 시나리오 안의 순서 번호(order_num). 시나리오별로 중복 불가 (api.ts에서 검사)
const { slug, order } = Astro.params as { slug: string; order: string };
const { DB, BUCKET } = bindings;

const scenario = await DB.prepare("SELECT * FROM scenarios WHERE slug = ?")
  .bind(slug)
  .first<Record<string, unknown>>();

if (!scenario) return Astro.redirect("/logs");

const log = await DB.prepare(
  "SELECT * FROM logs WHERE order_num = ? AND scenario_id = ?",
)
  .bind(parseInt(order), scenario.id)
  .first<Record<string, unknown>>();

if (!log) return Astro.redirect(`/logs/${slug}`);

const html = await getFromR2(BUCKET, log.html_r2 as string);
if (!html) return Astro.redirect(`/logs/${slug}`);

const prev = await DB.prepare(
  "SELECT id, title, order_num FROM logs WHERE scenario_id = ? AND order_num < ? ORDER BY order_num DESC LIMIT 1",
)
  .bind(scenario.id, log.order_num)
  .first<{ id: number; title: string; order_num: number }>();

const next = await DB.prepare(
  "SELECT id, title, order_num FROM logs WHERE scenario_id = ? AND order_num > ? ORDER BY order_num ASC LIMIT 1",
)
  .bind(scenario.id, log.order_num)
  .first<{ id: number; title: string; order_num: number }>();

const color = scenario.color as string;
---

<LogsLayout title={`${log.title as string} — ${scenario.title as string}`}>
  <div class="log-header" style={`--c: ${color}`}>
    <p class="breadcrumb">
      <a href="/logs">시나리오</a>
      <span>›</span>
      <a href={`/logs/${slug}`}>{scenario.title as string}</a>
    </p>
    <h1 class="log-title">{log.title as string}</h1>
    <p class="log-meta">#{log.order_num as number}</p>
  </div>

  <article class="log-body" set:html={html} />

  <nav class="log-nav" style={`--c: ${color}`} aria-label="로그 이동">
    {/* 첫 로그엔 '이전', 마지막 로그엔 '다음' 카드를 표시하지 않음 */}
    <div class="nav-cards">
      {
        prev && (
          <a href={`/logs/${slug}/${prev.order_num}`} class="nav-card nav-prev">
            <svg class="nav-chevron" viewBox="0 0 8 14" width="8" height="14" aria-hidden="true">
              <path d="M7 1L1 7l6 6" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"></path>
            </svg>
            <span class="nav-text">
              <span class="nav-label">이전 로그</span>
              <span class="nav-log-title">{prev.title}</span>
            </span>
          </a>
        )
      }
      {
        next && (
          <a href={`/logs/${slug}/${next.order_num}`} class="nav-card nav-next">
            <span class="nav-text">
              <span class="nav-label">다음 로그</span>
              <span class="nav-log-title">{next.title}</span>
            </span>
            <svg class="nav-chevron" viewBox="0 0 8 14" width="8" height="14" aria-hidden="true">
              <path d="M1 1l6 6-6 6" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"></path>
            </svg>
          </a>
        )
      }
      <a href={`/logs/${slug}`} class="nav-back">목록으로</a>
    </div>
  </nav>
</LogsLayout>

<style>
  .log-header {
    padding-bottom: 1.25rem;
  }
  .breadcrumb {
    font-size: 0.8rem;
    color: var(--muted);
    margin-bottom: 0.75rem;
    display: flex;
    gap: 0.4rem;
    align-items: center;
  }
  .breadcrumb a {
    color: var(--muted);
    text-decoration: none;
  }
  .log-title {
    font-size: 1.5rem;
    font-weight: 700;
    color: var(--text);
  }
  .log-meta {
    font-size: 0.78rem;
    color: var(--muted);
    margin-top: 0.25rem;
  }

  .log-body {
    max-width: 720px;
    font-size: 0.95rem;
    line-height: 1.9;
    letter-spacing: -0.04rem;
  }
  .log-body :global(p) {
    margin-bottom: 1em;
  }
  .log-body :global(hr) {
    border: none;
    border-top: 1px solid var(--border);
    margin: 2em 0;
  }
  .log-body :global(blockquote) {
    border-left: 3px solid var(--border);
    padding-left: 1em;
    color: var(--muted);
    margin: 1.5em 0;
  }

  /* 로그 이동: 시나리오 페이지의 iOS 목록과 같은 톤의 카드 */
  .log-nav {
    margin-top: 3rem;
  }
  /* [이전] [목록으로] [다음] 한 줄. 없는 카드 자리는 비워 둠 */
  .nav-cards {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto minmax(0, 1fr);
    align-items: center;
    gap: 0.75rem;
  }
  .nav-prev {
    grid-column: 1;
  }
  .nav-card {
    display: flex;
    align-items: center;
    gap: 0.9rem;
    min-width: 0;
    padding: 0.85rem 1.1rem;
    background: var(--surface);
    border-radius: 12px;
    color: var(--text);
    text-decoration: none;
    transition: background 0.15s;
  }
  .nav-card:hover {
    opacity: 1;
    background: color-mix(in srgb, var(--c) 7%, var(--surface));
  }
  .nav-card:active {
    background: color-mix(in srgb, var(--c) 14%, var(--surface));
  }
  .nav-next {
    grid-column: 3;
    justify-content: flex-end;
    text-align: right;
  }
  .nav-text {
    display: flex;
    flex-direction: column;
    gap: 0.1rem;
    min-width: 0;
  }
  .nav-label {
    font-size: 0.72rem;
    color: var(--muted);
  }
  .nav-log-title {
    font-size: 0.92rem;
    font-weight: 500;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }
  .nav-chevron {
    flex-shrink: 0;
    color: rgba(60, 60, 67, 0.3);
    transition:
      color 0.15s,
      transform 0.2s ease;
  }
  .nav-prev:hover .nav-chevron {
    color: var(--c);
    transform: translateX(-2px);
  }
  .nav-next:hover .nav-chevron {
    color: var(--c);
    transform: translateX(2px);
  }
  .nav-back {
    grid-column: 2;
    grid-row: 1;
    padding: 0.45rem 1.2rem;
    border-radius: 999px;
    background: var(--surface);
    font-size: 0.83rem;
    color: var(--muted);
    text-decoration: none;
    white-space: nowrap;
    transition:
      color 0.15s,
      background 0.15s;
  }
  .nav-back:hover {
    opacity: 1;
    color: var(--c);
    background: color-mix(in srgb, var(--c) 7%, var(--surface));
  }
  @media (max-width: 600px) {
    /* 모바일: 이전 · 다음 카드를 쌓고 목록으로는 맨 아래 가운데 */
    .nav-cards {
      grid-template-columns: minmax(0, 1fr);
    }
    .nav-prev,
    .nav-next {
      grid-column: 1;
    }
    .nav-back {
      grid-column: 1;
      grid-row: auto;
      justify-self: center;
    }
  }
</style>
